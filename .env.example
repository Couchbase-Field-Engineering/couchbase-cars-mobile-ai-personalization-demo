# Copy to .env. scripts/register_with_aom.py fills in the AOM_* values for you.

# --- Couchbase Agent Operations Manager -------------------------------------
# AOM as reached from the backend container (AOM's own compose stack, same machine).
AOM_URL=https://host.docker.internal:8090
# The AOM dashboard as your browser reaches it (linked from the story page at https://localhost:5158/story).
AOM_DASHBOARD_URL=https://localhost
# Issued by register_with_aom.py (POST /v1/agents) - the "Couchbase Cars Rental Concierge" agent.
AOM_AGENT_API_KEY=
# Issued by register_with_aom.py too - the "Couchbase Cars Vehicle Upgrade Agent" (runs Confirm on upgrades, Agent Memory).
AOM_UPGRADE_AGENT_API_KEY=
# AOM dashboard admin - used only to publish Knowledge Base documents from the daily Redshift unload.
AOM_ADMIN_USERNAME=admin
AOM_ADMIN_PASSWORD=
# Optional: pin the LLM AOM routes completions to (otherwise AOM's configured default).
AOM_LLM_PROVIDER=
AOM_LLM_MODEL=
# AOM serves a self-signed cert by default.
AOM_VERIFY_TLS=false

# --- Knowledge Base publishing (daily) ----------------------------------------
KB_WINDOW_DAYS=10
KB_PROFILE_LIMIT=150

# --- Sync Gateway URL handed to the phone -------------------------------------
# Leave blank to use the app's EXPO_PUBLIC_SG_URL. For a physical phone use your Mac's LAN IP.
SG_PUBLIC_URL=

# --- Amazon Redshift (live mode; blank = mock from the unloaded profile) ------
# Redshift Serverless workgroup (or REDSHIFT_CLUSTER_ID for a provisioned cluster),
# database, optional Secrets Manager secret and region for the Redshift Data API,
# which serves the live customer 360 and the playbook table. Needs boto3.
REDSHIFT_WORKGROUP=
REDSHIFT_DATABASE=
REDSHIFT_SECRET_ARN=
AWS_REGION=
REDSHIFT_CUSTOMER_VIEW=analytics.customer_360_current
REDSHIFT_PLAYBOOK_TABLE=content.customer_care_playbook

# --- Demo clock ----------------------------------------------------------------
# Blank = the unload's export_date, so days-to-pickup stays the same whenever you demo.
DEMO_TODAY=

APP_SECRET=change-me-for-anything-shared

# --- Browser UI (https://localhost:5158) ---------------------------------------
# The sign-in page in front of the app and the story page.
DEMO_USERNAME=demo
DEMO_PASSWORD=Couchbase123!
# Extra host names / IPs for the self-signed certificate (comma-separated).
TLS_HOSTS=
